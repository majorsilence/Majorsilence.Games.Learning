<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Version.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <WarningLevel>4</WarningLevel>
    </PropertyGroup>

    <!-- Steamworks.NET is only pulled in for a build that explicitly opts in
         (dotnet build -p:EnableSteam=true); the plain desktop/Android builds
         never reference it. SteamBootstrap.cs compiles to a no-op shell
         either way (see its #if STEAM), so Program.cs can call it unconditionally. -->
    <PropertyGroup Condition="'$(EnableSteam)' == 'true'">
        <DefineConstants>$(DefineConstants);STEAM</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(EnableSteam)' == 'true'">
        <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="ppy.SDL2-CS" />
        <None Remove="SixLabors.ImageSharp" />
        <None Remove="sdl2.nuget" />
        <None Remove="sdl2_mixer.nuget" />
        <None Remove="sdl2_image.nuget" />
        <None Remove="sdl2_ttf.nuget" />
        <None Remove="Surfaces\" />
        <None Remove="assets\" />
        <None Remove="assets\fonts\" />
        <None Remove="Textures\" />
    </ItemGroup>
    <ItemGroup>
        <None Update="assets\fonts\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\artwork\z-like\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\artwork\isometric-demo\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\artwork\titanic-demo\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\audio\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="assets\levels\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Majorsilence.Games.Core\Majorsilence.Games.Core.csproj" />
      <ProjectReference Include="..\Majorsilence.Games.Shared\Majorsilence.Games.Shared.csproj" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.10.5" />
        <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.4.5" />
        <PackageReference Include="SDL3-CS.Linux.TTF" Version="3.2.2.5" />
        <PackageReference Include="SDL3-CS.Linux.Mixer" Version="3.2.4.5" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="SDL3-CS.Windows" Version="3.4.10.5" />
        <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.4.5" />
        <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.5" />
        <PackageReference Include="SDL3-CS.Windows.Mixer" Version="3.2.4.5" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <PackageReference Include="SDL3-CS.MacOS" Version="3.4.10.5" />
        <PackageReference Include="SDL3-CS.MacOS.Image" Version="3.4.4.5" />
        <PackageReference Include="SDL3-CS.MacOS.TTF" Version="3.2.2.5" />
        <PackageReference Include="SDL3-CS.MacOS.Mixer" Version="3.2.4.5" />
    </ItemGroup>
</Project>
