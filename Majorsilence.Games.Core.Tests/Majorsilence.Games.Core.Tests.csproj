<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

    </PropertyGroup>

    <ItemGroup>
      <!-- The mtp-v2 flavour of xunit.v3, not the plain one: it builds the test
           assembly as a Microsoft.Testing.Platform application, which is what
           `dotnet test` drives on the .NET 10 SDK. The plain xunit.v3 package
           ships its own console runner instead, which `dotnet test` cannot talk
           to - it reports "Zero tests ran" against a suite that is fine. The
           matching opt-in lives in global.json at the repo root. -->
      <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Majorsilence.Games.Learning\Majorsilence.Games.Learning.csproj" />
      <ProjectReference Include="..\Majorsilence.Games.Rpg\Majorsilence.Games.Rpg.csproj" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.10.5" />
        <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.4.5" />
        <PackageReference Include="SDL3-CS.Linux.TTF" Version="3.2.2.5" />
        <PackageReference Include="SDL3-CS.Linux.Mixer" Version="3.2.4.5" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="SDL3-CS.Windows" Version="3.4.10.5" />
        <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.4.5" />
        <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.5" />
        <PackageReference Include="SDL3-CS.Windows.Mixer" Version="3.2.4.5" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <PackageReference Include="SDL3-CS.MacOS" Version="3.4.10.5" />
        <PackageReference Include="SDL3-CS.MacOS.Image" Version="3.4.4.5" />
        <PackageReference Include="SDL3-CS.MacOS.TTF" Version="3.2.2.5" />
        <PackageReference Include="SDL3-CS.MacOS.Mixer" Version="3.2.4.5" />
    </ItemGroup>

    <!-- The RPG's data files, so the tests can check the shipped roster, spell
         book and monster book actually parse and agree with each other. -->
    <ItemGroup>
        <None Include="$(MSBuildProjectDirectory)/../Majorsilence.Games.Rpg/assets/*.json" Link="assets/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildProjectDirectory)/../Majorsilence.Games.Learning/assets/artwork/z-like/*.png" Link="assets/artwork/z-like/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="$(MSBuildProjectDirectory)/../Majorsilence.Games.Learning/assets/fonts/*.ttf" Link="assets/fonts/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="$(MSBuildProjectDirectory)/../Majorsilence.Games.Learning/assets/audio/*.mp3" Link="assets/audio/%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
