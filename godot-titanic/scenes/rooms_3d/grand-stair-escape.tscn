[sub_resource type="Shader" id="Shader_checker"]
code = "shader_type spatial;
render_mode blend_mix, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec3 color_a : source_color = vec3(0.05, 0.05, 0.06);
uniform vec3 color_b : source_color = vec3(0.92, 0.9, 0.85);
uniform float tile_count = 6.0;

void fragment() {
	vec2 uv = UV * tile_count;
	vec2 cell = floor(uv);
	float check = mod(cell.x + cell.y, 2.0);
	ALBEDO = mix(color_a, color_b, check);
	ROUGHNESS = 0.25;
	METALLIC = 0.0;
	SPECULAR = 0.5;
}
"

